PORT=3001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hr_outreach_tracker
JWT_SECRET=change-me-in-production

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Single connection used for both: outreach email sending AND Gmail sync/tracking
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

# 32-byte hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=

# GitHub Backup (optional — configure via Admin panel after login)
# GITHUB_TOKEN is stored in DB settings, not required here

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Webhook secret from https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=...
# Create subscription plans at https://dashboard.razorpay.com/app/subscriptions/plans
RAZORPAY_BASIC_PLAN_ID=plan_...
RAZORPAY_ADVANCED_PLAN_ID=plan_...

# ── Groq AI Chatbot ───────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
