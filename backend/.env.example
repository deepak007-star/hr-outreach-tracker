PORT=3001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hr_outreach_tracker
JWT_SECRET=change-me-in-production

# Anti cold-start: on free hosts (Render/Vercel) the backend sleeps after ~15 min
# of inactivity, causing slow first loads and pausing scheduled scrapers. Set this
# to your DEPLOYED BACKEND URL and it will self-ping /api/health every 10 min to
# stay warm. On Render, RENDER_EXTERNAL_URL is auto-provided, so this is optional
# there. Leave blank for local dev.
PUBLIC_URL=
# KEEP_ALIVE_MINUTES=10   # self-ping cadence (must be < the host's 15-min sleep window)

# Dev login bypass — shows a "Dev Login" button that enters the app as an admin
# (all features, no restriction) with no credentials. Defaults ON when NODE_ENV
# is not "production". Set to false to force off, true to force on.
# WARNING: never enable this on a public/internet-facing server — it grants
# anyone full admin access.
DEV_LOGIN_BYPASS=true

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Single connection used for both: outreach email sending AND Gmail sync/tracking
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

# 32-byte hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=

# GitHub Backup (optional — configure via Admin panel after login)
# GITHUB_TOKEN is stored in DB settings, not required here

# ── Razorpay Payment Gateway (Orders API — no plan IDs needed) ───────────────
# Keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Webhook secret from https://dashboard.razorpay.com/app/webhooks (optional for local dev)
RAZORPAY_WEBHOOK_SECRET=...

# ── Groq AI Chatbot ───────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
