PORT=3001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hr_outreach_tracker
JWT_SECRET=change-me-in-production

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Used for both: email sending OAuth + Gmail tracking OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI for outreach email sending OAuth (existing flow)
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

# Redirect URI for Gmail read/track OAuth (new scraper integration)
GMAIL_REDIRECT_URI=http://localhost:3001/api/gmail/callback

# 32-byte hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=

# GitHub Backup (optional — configure via Admin panel after login)
# GITHUB_TOKEN is stored in DB settings, not required here
