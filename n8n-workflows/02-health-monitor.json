{
  "name": "02 - Health Monitor (Every 5 min)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "cron-5min",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/health",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "check-health",
      "name": "GET /api/health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "status-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "is-healthy",
      "name": "Backend healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Backend is down — log the incident with timestamp\nconst ts = new Date().toISOString();\nconsole.error(`[n8n] HEALTH ALERT at ${ts}: backend is DOWN`);\nreturn [{ json: { alert: true, timestamp: ts, response: $input.first().json } }];"
      },
      "id": "alert-down",
      "name": "Alert: Backend Down",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 420]
    },
    {
      "parameters": {
        "jsCode": "// Backend is healthy — optionally log for observability\n// console.log('[n8n] Health OK:', new Date().toISOString());\nreturn $input.all();"
      },
      "id": "healthy-ok",
      "name": "Healthy (no-op)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 180]
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [{ "node": "GET /api/health", "type": "main", "index": 0 }]
      ]
    },
    "GET /api/health": {
      "main": [
        [{ "node": "Backend healthy?", "type": "main", "index": 0 }]
      ]
    },
    "Backend healthy?": {
      "main": [
        [{ "node": "Healthy (no-op)", "type": "main", "index": 0 }],
        [{ "node": "Alert: Backend Down", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "notes": "Checks GET /api/health every 5 minutes. If the backend is unreachable or returns a non-ok status, the Alert node fires. Wire the Alert node to an email/Slack/Telegram node to get notified. Activate after configuring your alert destination."
}
